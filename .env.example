DATABASE_URL="mysql://scav:***@localhost:3306/scav"
# Se o MySQL local usar caching_sha2_password sem TLS, acrescente
# ?allowPublicKeyRetrieval=true ao DATABASE_URL. Em produção, prefira TLS.
AUTH_URL="http://localhost:3000"
# Gere um segredo aleatório: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""
# Remetente padrão (domínio verificado no Resend)
EMAIL_FROM="SCAV <onboarding@seudominio.com>"
